    "Your plan and dishes are stored on your device and shared with your family through iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Plan und deine Gerichte werden auf deinem Gerät gespeichert und über iCloud mit deiner Familie geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan y tus platos se guardan en tu dispositivo y se comparten con tu familia a través de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
