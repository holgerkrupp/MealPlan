    "Invite people as editors, or as view-only guests who can look but not change." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviter folk som redaktører eller som gæster med kun læseadgang, der kan se med, men ikke ændre noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Leute als Bearbeiter ein oder als Gäste, die nur mitlesen dürfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a otras personas como editores o como invitados que solo pueden mirar, no cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitez des personnes comme éditeurs ou comme invités en lecture seule, qui peuvent regarder sans modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita le persone come editor o come ospiti in sola lettura, che possono guardare ma non modificare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodig mensen uit als bewerker of als alleen-lezen gast, die wel kan meekijken maar niets kan wijzigen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convida pessoas como editores ou como convidados só de leitura, que podem ver mas não alterar."
          }
        }
      }
    },
