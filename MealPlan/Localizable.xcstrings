    "Event titles" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termintitel"
          }
        }
      }
    },
    "Shows only when someone is busy, never what they are doing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur, wann jemand beschäftigt ist – nie, womit."
          }
        }
      }
    },
    "Also shows the title of an event. Notes, invitees, locations and links are never shown." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt zusätzlich den Titel eines Termins. Notizen, Teilnehmende, Orte und Links werden nie gezeigt."
          }
        }
      }
    },
    "Use Calendar for meal planning" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender für die Essensplanung nutzen"
          }
        }
      }
    },
    "Calendar options" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender-Optionen"
          }
        }
      }
    },
    "Calendar integration" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender-Integration"
          }
        }
      }
    },
    "Use events from selected calendars to provide helpful context when planning meals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine aus ausgewählten Kalendern geben hilfreichen Kontext bei der Essensplanung."
          }
        }
      }
    },
    "MealPlan needs permission to read your calendars. It shows only whether people are busy around a meal — and never changes, adds or deletes anything in Calendar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan braucht die Erlaubnis, deine Kalender zu lesen. Es zeigt nur, ob jemand rund um eine Mahlzeit beschäftigt ist – und ändert, ergänzt oder löscht nie etwas im Kalender."
          }
        }
      }
    },
    "Allow Calendar access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderzugriff erlauben"
          }
        }
      }
    },
    "Open Settings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen öffnen"
          }
        }
      }
    },
    "Choose calendars" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender auswählen"
          }
        }
      }
    },
    "1 calendar" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Kalender"
          }
        }
      }
    },
    "%lld calendars" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Kalender"
          }
        }
      }
    },
    "Calendar integration isn’t available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender-Integration ist nicht verfügbar."
          }
        }
      }
    },
    "These choices stay on this device and are never shared with your family or iCloud. MealPlan only reads your calendars — it never adds, changes or deletes events." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen bleiben auf diesem Gerät und werden weder mit deiner Familie noch über iCloud geteilt. MealPlan liest deine Kalender nur – es fügt nie Termine hinzu, ändert oder löscht sie."
          }
        }
      }
    },
    "Calendar access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderzugriff"
          }
        }
      }
    },
    "Looking for calendars…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nach Kalendern …"
          }
        }
      }
    },
