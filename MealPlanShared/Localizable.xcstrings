    "Energy is the only value MealPlan needs. Anything you leave blank counts as zero for this ingredient." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energi er den eneste værdi, MealPlan har brug for. Alt, du lader stå tomt, tæller som nul for denne ingrediens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La energía es el único valor que MealPlan necesita. Lo que dejes en blanco cuenta como cero para este ingrediente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’énergie est la seule valeur dont MealPlan a besoin. Tout champ laissé vide compte comme zéro pour cet ingrédient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’energia è l’unico valore di cui MealPlan ha bisogno. Ciò che lasci vuoto conta come zero per questo ingrediente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie is de enige waarde die MealPlan nodig heeft. Wat je leeg laat, telt als nul voor dit ingrediënt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A energia é o único valor de que o MealPlan precisa. O que deixares em branco conta como zero para este ingrediente."
          }
        }
      }
    },
