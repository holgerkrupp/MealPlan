{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld left": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %1$lld von %2$lld"
          }
        }
      }
    },
    "All ticked off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles abgehakt"
          }
        }
      }
    },
    "Build your list on iPhone and it shows up here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle deine Liste auf dem iPhone – sie erscheint hier."
          }
        }
      }
    },
    "Double tap to tick off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen zum Abhaken"
          }
        }
      }
    },
