    "Save a good week as a template and reuse it when you run out of ideas." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere eine gelungene Woche als Vorlage und nutze sie wieder, wenn dir die Ideen ausgehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una buena semana como plantilla y reutilízala cuando te falten ideas."
