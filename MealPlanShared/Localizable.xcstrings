    "This store holds %lld family records — two devices each created one before they first synced. Restoring a backup folds them back into a single family." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette lager indeholder %lld familieposter — to enheder oprettede hver sin, før de synkroniserede første gang. Gendannelse af en sikkerhedskopi samler dem til én familie igen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este almacén contiene %lld registros de familia: dos dispositivos crearon uno cada uno antes de sincronizarse por primera vez. Restaurar una copia de seguridad los reúne de nuevo en una sola familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet espace contient %lld enregistrements de famille — deux appareils en ont créé un chacun avant leur première synchronisation. Restaurer une sauvegarde les réunit en une seule famille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo archivio contiene %lld record di famiglia: due dispositivi ne hanno creato uno ciascuno prima della prima sincronizzazione. Ripristinare un backup li riunisce in un’unica famiglia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze opslag bevat %lld gezinsrecords — twee apparaten maakten er elk een aan voordat ze voor het eerst synchroniseerden. Een back-up terugzetten voegt ze weer samen tot één gezin."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este armazenamento tem %lld registos de família — dois dispositivos criaram um cada antes da primeira sincronização. Restaurar uma cópia de segurança volta a juntá-los numa só família."
          }
        }
      }
    },
