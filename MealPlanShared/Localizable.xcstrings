          "stringUnit" : {
            "state" : "translated",
            "value" : "De næste måltider i planen — dage, du ikke har udfyldt, springes over."
          }
        }
      }
    },
    "The plan shows one card per meal per day. Fill the cards you care about and leave the rest empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Plan zeigt pro Tag eine Karte je Mahlzeit. Füll die Karten, die dich interessieren, und lass den Rest leer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan muestra una tarjeta por comida y día. Rellena las tarjetas que te importen y deja el resto vacías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le menu affiche une carte par repas et par jour. Remplissez les cartes qui vous intéressent et laissez les autres vides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano mostra una scheda per ogni pasto di ogni giorno. Riempi le schede che ti interessano e lascia vuote le altre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het plan toont per dag één kaart per maaltijd. Vul de kaarten in die er voor jou toe doen en laat de rest leeg."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano mostra um cartão por refeição em cada dia. Preenche os cartões que te interessam e deixa os restantes vazios."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen viser ét kort pr. måltid pr. dag. Udfyld de kort, du går op i, og lad resten stå tomme."
          }
        }
      }
    },
