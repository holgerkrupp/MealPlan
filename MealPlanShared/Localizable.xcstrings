        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre condividi puoi mettere il nuovo piatto direttamente in un giorno del tuo piano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens het delen kun je het nieuwe gerecht meteen op een dag in je plan zetten."
