    "Items are sorted by aisle, and you can rename an aisle so it matches your shop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einträge sind nach Abteilung sortiert, und du kannst eine Abteilung passend zu deinem Laden umbenennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los artículos se ordenan por pasillo, y puedes renombrar un pasillo para que coincida con tu tienda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les articles sont triés par rayon, et vous pouvez renommer un rayon pour qu’il corresponde à votre magasin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli articoli sono ordinati per reparto e puoi rinominare un reparto per adattarlo al tuo negozio."
          }
        },
        "nl" : {
          "stringUnit" : {
