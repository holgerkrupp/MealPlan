          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riga in basso lo pianifica come extra di quel giorno, senza occupare uno dei tuoi pasti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De onderste rij plant het als extra op die dag, zonder een van je maaltijden te gebruiken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
