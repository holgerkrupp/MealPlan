    "Use tags for diets, occasions, collections, and anything else you want to find again. A few are suggested from the name and ingredients." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug tags til diæter, anledninger, samlinger og alt andet, du vil kunne finde igen. Nogle foreslås ud fra navn og ingredienser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Tags für Ernährungsweisen, Anlässe, Sammlungen und alles, was du wiederfinden möchtest. Einige werden aus Name und Zutaten vorgeschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use tags for diets, occasions, collections, and anything else you want to find again. A few are suggested from the name and ingredients."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa etiquetas para dietas, ocasiones, colecciones y todo lo que quieras volver a encontrar. Algunas se sugieren a partir del nombre y los ingredientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les tags pour les régimes, les occasions, les collections et tout ce que vous voulez retrouver. Quelques-uns sont suggérés d’après le nom et les ingrédients."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa i tag per diete, occasioni, raccolte e tutto ciò che vuoi ritrovare. Alcuni vengono suggeriti dal nome e dagli ingredienti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik labels voor diëten, gelegenheden, verzamelingen en alles wat je wilt terugvinden. Een paar worden voorgesteld op basis van de naam en de ingrediënten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa etiquetas para dietas, ocasiões, coleções e tudo o que queiras voltar a encontrar. Algumas são sugeridas a partir do nome e dos ingredientes."
          }
        }
      }
