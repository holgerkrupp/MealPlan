    "Plan the next 7 days for free, or unlock MealPlan to plan as far ahead as you like." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlæg de næste 7 dage gratis, eller lås MealPlan op for at planlægge så langt frem, du vil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica los próximos 7 días gratis o desbloquea MealPlan para planificar con toda la antelación que quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez les 7 prochains jours gratuitement, ou débloquez MealPlan pour planifier aussi loin que vous voulez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica gratis i prossimi 7 giorni oppure sblocca MealPlan per pianificare quanto avanti vuoi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan de komende 7 dagen gratis, of ontgrendel MealPlan om zo ver vooruit te plannen als je wilt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeia gratuitamente os próximos 7 dias ou desbloqueia o MealPlan para planear tão longe quanto quiseres."
          }
        }
      }
    },
