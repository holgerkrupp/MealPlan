    "Found a recipe on a website, in another recipe app, or in a message? Share it to MealPlan instead of typing it in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rezept auf einer Website, in einer anderen Rezept-App oder in einer Nachricht gefunden? Teile es zu MealPlan, statt es abzutippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has encontrado una receta en una web, en otra app de recetas o en un mensaje? Compártela con MealPlan en vez de volver a escribirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez trouvé une recette sur un site, dans une autre app de recettes ou dans un message ? Partagez-la vers MealPlan au lieu de la retaper."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai trovato una ricetta su un sito, in un’altra app di ricette o in un messaggio? Condividila con MealPlan invece di riscriverla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een recept gevonden op een website, in een andere receptenapp of in een bericht? Deel het met MealPlan in plaats van het over te typen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontraste uma receita num site, noutra app de receitas ou numa mensagem? Partilha-a para o MealPlan em vez de a escreveres outra vez."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundet en opskrift på en hjemmeside, i en anden opskriftsapp eller i en besked? Del den til MealPlan i stedet for at taste den ind igen."
          }
        }
      }
    },
