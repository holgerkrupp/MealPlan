    "Check the split is right, then save. The dish opens for editing and is marked to review." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que la división sea correcta y guarda. El plato se abre para editarlo y queda marcado para revisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que le découpage est correct, puis enregistrez. Le plat s’ouvre en modification et est marqué à vérifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla che la suddivisione sia corretta, poi salva. Il piatto si apre in modifica ed è contrassegnato da rivedere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer of de opsplitsing klopt en bewaar. Het gerecht opent om te bewerken en wordt gemarkeerd om na te kijken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica se a divisão está correta e guarda. O prato abre para edição e fica marcado para revisão."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek, at opdelingen er rigtig, og gem. Retten åbnes til redigering og markeres til gennemsyn."
          }
        }
      }
    },
    "Choose a date range and rebuild the list; the same ingredient from several dishes is added up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Zeitraum und baue die Liste neu auf; gleiche Zutaten aus mehreren Gerichten werden zusammengezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un intervalo de fechas y vuelve a crear la lista; el mismo ingrediente de varios platos se suma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une période et reconstruisez la liste ; un même ingrédient issu de plusieurs plats est additionné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un intervallo di date e ricrea la lista; lo stesso ingrediente presente in più piatti viene sommato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een periode en bouw de lijst opnieuw op; hetzelfde ingrediënt uit meerdere gerechten wordt opgeteld."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe um intervalo de datas e reconstrói a lista; o mesmo ingrediente de vários pratos é somado."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en periode, og byg listen op igen; den samme ingrediens fra flere retter lægges sammen."
          }
        }
      }
    },
