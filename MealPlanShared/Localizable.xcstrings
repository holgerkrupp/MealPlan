    "Dishes are the heart of the app: everything you plan, cook, and shop for comes from your library." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retterne er appens hjerte: alt, hvad du planlægger, laver og køber ind til, kommer fra din samling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerichte sind das Herz der App: Alles, was du planst, kochst und einkaufst, kommt aus deiner Sammlung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los platos son el corazón de la app: todo lo que planificas, cocinas y compras sale de tu colección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plats sont le cœur de l’app : tout ce que vous planifiez, cuisinez et achetez vient de votre collection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
