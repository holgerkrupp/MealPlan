    "Items are sorted by aisle, and you can rename an aisle so it matches your shop." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varerne er sorteret efter afdeling, og du kan omdøbe en afdeling, så den passer til din butik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
