<?xml version="1.0" encoding="UTF-8"?>
<!--
  The static launch screen. It must be pixel-identical to the first frame of
  AnimatedLaunchView, otherwise the handoff from system launch screen to app
  flickers.

  The background and mark come from Assets.xcassets — the same assets
  AnimatedLaunchView reads — so the handoff remains seamless.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="NO" colorMatched="YES" initialViewController="LNC-vc-001">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch Screen-->
        <scene sceneID="LNC-sc-001">
            <objects>
                <viewController id="LNC-vc-001" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LNC-rv-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="LNC-im-001">
                                <rect key="frame" x="86.76" y="311.76" width="220.08" height="220.08"/>
                                <constraints>
                                    <constraint firstAttribute="height" secondItem="LNC-im-001" secondAttribute="width" multiplier="1" id="LNC-c5-001"/>
                                    <constraint firstAttribute="width" relation="lessThanOrEqual" constant="280" id="LNC-c4-001"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="LNC-sa-001"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="LNC-im-001" firstAttribute="centerX" secondItem="LNC-rv-001" secondAttribute="centerX" id="LNC-c6-001"/>
                            <constraint firstItem="LNC-im-001" firstAttribute="centerY" secondItem="LNC-rv-001" secondAttribute="centerY" id="LNC-c7-001"/>
                            <constraint firstItem="LNC-im-001" firstAttribute="width" secondItem="LNC-rv-001" secondAttribute="width" multiplier="0.56" priority="750" id="LNC-c8-001"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LNC-fr-001" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52" y="374"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchMark" width="1024" height="1024"/>
        <namedColor name="LaunchBackground">
            <color red="0.929" green="0.847" blue="0.871" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
