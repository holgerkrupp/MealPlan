    "Tap a meal to pick a dish, or drag a dish over from the list beside the plan." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på et måltid for at vælge en ret, eller træk en ret over fra listen ved siden af planen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Mahlzeit, um ein Gericht zu wählen – oder zieh ein Gericht aus der Liste neben dem Plan herüber."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una comida para elegir un plato o arrastra un plato desde la lista junto al plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un repas pour choisir un plat, ou faites glisser un plat depuis la liste à côté du menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un pasto per scegliere un piatto, oppure trascina un piatto dall’elenco accanto al piano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een maaltijd om een gerecht te kiezen, of sleep een gerecht uit de lijst naast het plan."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca numa refeição para escolher um prato ou arrasta um prato da lista ao lado do plano."
          }
        }
      }
    },
    "Tap a slot to choose the day and meal." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en plads for at vælge dag og måltid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Feld, um Tag und Mahlzeit zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un hueco para elegir el día y la comida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un emplacement pour choisir le jour et le repas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca uno slot per scegliere giorno e pasto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een plek om de dag en maaltijd te kiezen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca num espaço para escolheres o dia e a refeição."
          }
        }
      }
    },
    "Tap a slot to choose the day and meal. The bottom row plans it as an extra on that day, without using one of your meals." : {

    },
    "Tap a slot to move this meal. The bottom row makes it an extra on that day, outside your usual meals." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en plads for at flytte dette måltid. Nederste række gør det til et ekstra måltid den dag, uden for dine sædvanlige måltider."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Feld, um diese Mahlzeit zu verschieben. Die unterste Reihe macht sie zu einem Extra an diesem Tag, außerhalb deiner üblichen Mahlzeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un hueco para mover esta comida. La fila de abajo la convierte en un extra de ese día, fuera de tus comidas habituales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un emplacement pour déplacer ce repas. La rangée du bas en fait un extra ce jour-là, en dehors de vos repas habituels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca uno slot per spostare questo pasto. La riga in basso lo rende un extra di quel giorno, fuori dai pasti abituali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een plek om deze maaltijd te verplaatsen. De onderste rij maakt er een extra van op die dag, buiten je gewone maaltijden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca num espaço para mover esta refeição. A linha de baixo torna-a um extra nesse dia, fora das tuas refeições habituais."
          }
        }
      }
    },
    "Tap a slot to plan it" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
