    "Cook the pasta. Warm the tomato sauce, combine, and season to taste." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kog pastaen. Varm tomatsovsen, bland det hele, og smag til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koche die Nudeln. Erwärme die Tomatensoße, vermische alles und schmecke es ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook the pasta. Warm the tomato sauce, combine, and season to taste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuece la pasta. Calienta la salsa de tomate, mézclalo todo y salpimenta al gusto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites cuire les pâtes. Réchauffez la sauce tomate, mélangez et assaisonnez à votre goût."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuoci la pasta. Scalda il sugo di pomodoro, unisci e regola di sale."
