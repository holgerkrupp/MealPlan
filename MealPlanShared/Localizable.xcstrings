    "On iPhone and iPad, share a recipe page from Safari or another app straight to MealPlan — it appears here through iCloud." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På iPhone og iPad kan du dele en opskriftsside fra Safari eller en anden app direkte til MealPlan — den dukker op her via iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile auf iPhone und iPad eine Rezeptseite aus Safari oder einer anderen App direkt zu MealPlan – über iCloud taucht sie hier auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iPhone y iPad, comparte una página de receta desde Safari u otra app directamente con MealPlan: aparece aquí a través de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur iPhone et iPad, partagez une page de recette depuis Safari ou une autre app directement vers MealPlan — elle apparaît ici via iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su iPhone e iPad, condividi una pagina di ricetta da Safari o da un’altra app direttamente in MealPlan: compare qui tramite iCloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel op iPhone en iPad een receptpagina vanuit Safari of een andere app rechtstreeks naar MealPlan — hij verschijnt hier via iCloud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPhone e no iPad, partilha uma página de receita a partir do Safari ou de outra app diretamente para o MealPlan — aparece aqui através do iCloud."
          }
        }
      }
