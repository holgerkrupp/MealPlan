    "System Default" : {

    },
    "Tag dishes as vegetarian, quick, or a kids’ favorite, then filter the library by it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt tags på retter som vegetarisk, hurtig eller børnenes favorit, og filtrér samlingen efter dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versieh Gerichte mit Schlagwörtern wie vegetarisch, schnell oder Kinderliebling und filtere die Sammlung danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta los platos como vegetariano, rápido o favorito de los niños, y luego filtra la colección por ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taguez les plats comme végétarien, rapide ou préféré des enfants, puis filtrez la collection selon ces tags."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegna ai piatti tag come vegetariano, veloce o preferito dai bambini, poi filtra la raccolta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef gerechten labels als vegetarisch, snel of kinderfavoriet en filter je collectie erop."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta os pratos como vegetariano, rápido ou favorito das crianças e depois filtra a coleção por isso."
          }
        }
      }
    },
