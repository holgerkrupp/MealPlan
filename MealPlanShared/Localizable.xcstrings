    "Regular meals are planned %lld weeks ahead, and only into meals that are still empty. Change or remove a single week right in the plan — the routine keeps going." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faste måltider planlægges %lld uger frem og kun ind i måltider, der stadig er tomme. Ret eller fjern en enkelt uge direkte i planen — rutinen fortsætter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las comidas fijas se planifican con %lld semanas de antelación y solo en las comidas que siguen vacías. Cambia o elimina una semana concreta directamente en el plan: la rutina sigue adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les repas réguliers sont planifiés %lld semaines à l’avance, et uniquement dans les repas encore vides. Modifiez ou supprimez une semaine directement dans le menu — la routine se poursuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pasti ricorrenti vengono pianificati con %lld settimane di anticipo e solo nei pasti ancora vuoti. Cambia o elimina una singola settimana direttamente nel piano: la routine prosegue."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaste maaltijden worden %lld weken vooruit gepland, en alleen in maaltijden die nog leeg zijn. Wijzig of verwijder één week direct in het plan — de routine loopt door."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As refeições regulares são planeadas com %lld semanas de antecedência e apenas nas refeições que ainda estão vazias. Altera ou remove uma semana diretamente no plano — a rotina continua."
          }
        }
      }
    },
