    "The next meals on the plan, skipping the days you haven’t filled in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächsten Mahlzeiten im Plan – Tage ohne Eintrag werden übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las próximas comidas del plan, saltándose los días que no has rellenado."
          }
