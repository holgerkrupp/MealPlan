    "Turn the planned week into a shopping list without writing it twice." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav den planlagte uge om til en indkøbsliste uden at skrive alt to gange."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach aus der geplanten Woche eine Einkaufsliste, ohne alles zweimal zu schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte la semana planificada en una lista de la compra sin escribirlo todo dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformez la semaine planifiée en liste de courses sans tout écrire deux fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma la settimana pianificata in una lista della spesa senza scrivere tutto due volte."
          }
