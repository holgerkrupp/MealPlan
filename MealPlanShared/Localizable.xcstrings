    "MealPlan couldn’t save the Bring! password to the keychain: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan konnte das Bring!-Passwort nicht im Schlüsselbund speichern: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan no pudo guardar la contraseña de Bring! en el llavero: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan n’a pas pu enregistrer le mot de passe Bring! dans le trousseau : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan non è riuscito a salvare la password di Bring! nel portachiavi: %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan kon het Bring!-wachtwoord niet in de sleutelhanger bewaren: %@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MealPlan não conseguiu guardar a palavra-passe do Bring! no porta-chaves: %@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan kunne ikke gemme Bring!-adgangskoden i nøgleringen: %@"
          }
        }
      }
    },
    "MealPlan doesn’t have permission to add to Reminders." : {
