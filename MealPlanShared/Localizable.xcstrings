    "Mix a smooth batter and cook small portions in a lightly greased pan until golden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rühre einen glatten Teig und backe kleine Portionen in einer leicht gefetteten Pfanne goldbraun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mix a smooth batter and cook small portions in a lightly greased pan until golden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara una masa homogénea y cocina porciones pequeñas en una sartén ligeramente engrasada hasta que estén doradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez une pâte lisse et faites cuire de petites portions dans une poêle légèrement graissée jusqu’à ce qu’elles soient dorées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara una pastella liscia e cuoci piccole porzioni in una padella leggermente unta finché sono dorate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roer een glad beslag en bak kleine porties in een licht ingevette pan tot ze goudbruin zijn."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
