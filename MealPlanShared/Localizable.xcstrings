    "Choose any you already cook. They are ordinary dishes, so you can edit or delete them anytime." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Gerichte, die du bereits kochst. Es sind ganz normale Gerichte, die du jederzeit bearbeiten oder löschen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose any you already cook. They are ordinary dishes, so you can edit or delete them anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los que ya cocinas. Son platos normales, así que puedes editarlos o eliminarlos cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ceux que vous cuisinez déjà. Ce sont des plats ordinaires : vous pouvez les modifier ou les supprimer à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quelli che già cucini. Sono piatti normali, quindi puoi modificarli o eliminarli quando vuoi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies wat je al kookt. Het zijn gewone gerechten, dus je kunt ze altijd bewerken of verwijderen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe os que já cozinhas. São pratos normais, por isso podes editá-los ou eliminá-los quando quiseres."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg dem, du allerede laver. Det er helt almindelige retter, så du kan redigere eller slette dem når som helst."
          }
        }
      }
    },
