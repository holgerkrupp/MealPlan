    },
    "Event notes, invitees, locations and links are never read, shown or stored." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noter, deltagere, steder og links i begivenheder læses, vises eller gemmes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen, Teilnehmende, Orte und Links von Terminen werden nie gelesen, gezeigt oder gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas, los invitados, las ubicaciones y los enlaces de los eventos nunca se leen, se muestran ni se guardan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes, participants, lieux et liens des événements ne sont jamais lus, affichés ni enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note, invitati, luoghi e link degli eventi non vengono mai letti, mostrati o salvati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notities, genodigden, locaties en links van afspraken worden nooit gelezen, getoond of bewaard."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notas, os convidados, os locais e os links dos eventos nunca são lidos, mostrados nem guardados."
          }
        }
      }
    },
