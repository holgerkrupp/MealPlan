        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur je boodschappenlijst naar Bring! of houd de twee gelijk: iets afvinken in de ene app vinkt het ook af in de andere."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
