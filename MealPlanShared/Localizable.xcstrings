    "Send your shopping list to Bring!, or keep the two in step so ticking something off in either app ticks it off in the other." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send din indkøbsliste til Bring!, eller hold de to synkroniserede, så en afkrydsning i den ene app også krydser af i den anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende deine Einkaufsliste an Bring! oder halte beide synchron – abgehakt in der einen App heißt abgehakt in der anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía tu lista de la compra a Bring! o mantén las dos sincronizadas: marcar algo en una app lo marca en la otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez votre liste de courses vers Bring!, ou gardez les deux synchronisées : cocher un article dans l’une le coche dans l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia la tua lista della spesa a Bring! oppure mantieni le due sincronizzate: spuntare qualcosa in un’app lo spunta anche nell’altra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur je boodschappenlijst naar Bring! of houd de twee gelijk: iets afvinken in de ene app vinkt het ook af in de andere."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia a tua lista de compras para o Bring! ou mantém as duas sincronizadas: assinalar algo numa das apps assinala-o na outra."
          }
        }
      }
    },
