    "MealPlan is made for a household, not just one cook. Everything is stored on your device and shared through iCloud." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan er lavet til en husstand, ikke kun til én kok. Alt gemmes på din enhed og deles via iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan ist für einen Haushalt gemacht, nicht nur für eine Person am Herd. Alles liegt auf deinem Gerät und wird über iCloud geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan está pensado para un hogar, no solo para quien cocina. Todo se guarda en tu dispositivo y se comparte a través de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan est conçu pour un foyer, pas seulement pour une personne aux fourneaux. Tout est stocké sur votre appareil et partagé via iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan è pensato per tutta la famiglia, non solo per chi cucina. Tutto è archiviato sul tuo dispositivo e condiviso tramite iCloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MealPlan is gemaakt voor een huishouden, niet alleen voor één kok. Alles staat op je apparaat en wordt via iCloud gedeeld."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MealPlan foi feito para uma casa, não apenas para quem cozinha. Tudo fica guardado no teu dispositivo e é partilhado através do iCloud."
          }
        }
      }
    },
    "MealPlan isn’t connected to Bring! yet." : {
      "localizations" : {
