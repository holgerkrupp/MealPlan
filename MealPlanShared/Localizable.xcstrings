    },
    "Shows only when someone is busy, never what they are doing." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser kun, hvornår nogen er optaget — aldrig med hvad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur, wann jemand beschäftigt ist – nie, womit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo muestra cuándo alguien está ocupado, nunca qué está haciendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique seulement quand une personne est occupée, jamais ce qu’elle fait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra solo quando qualcuno è impegnato, mai cosa sta facendo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont alleen wanneer iemand bezet is, nooit waarmee."
