    "Chop the vegetables, stir-fry until crisp-tender, then season and serve with rice." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snit grøntsagerne, svits dem sprøde, krydr dem, og server med ris."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneide das Gemüse, brate es bissfest an, würze es und serviere es mit Reis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chop the vegetables, stir-fry until crisp-tender, then season and serve with rice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta las verduras, saltéalas hasta que estén al dente, sazona y sirve con arroz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupez les légumes, faites-les sauter jusqu’à ce qu’ils soient croquants, assaisonnez et servez avec du riz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taglia le verdure, saltale finché restano croccanti, condisci e servi con il riso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snijd de groenten, roerbak ze beetgaar, breng op smaak en serveer met rijst."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta os legumes, salteia-os até ficarem estaladiços, tempera e serve com arroz."
          }
        }
      }
    },
