    "Please try again." : {

    },
    "Point the camera at a recipe book, or pick screenshots. Text recognition runs on this device. Printed recipes work best; handwriting may need more corrections." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ret kameraet mod en kogebog, eller vælg skærmbilleder. Tekstgenkendelsen kører på denne enhed. Trykte opskrifter virker bedst; håndskrift kan kræve flere rettelser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara a un libro de cocina o elige capturas de pantalla. El reconocimiento de texto se ejecuta en este dispositivo. Las recetas impresas funcionan mejor; la escritura a mano puede necesitar más correcciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez l’appareil photo vers un livre de cuisine, ou choisissez des captures d’écran. La reconnaissance de texte s’effectue sur cet appareil. Les recettes imprimées fonctionnent le mieux ; l’écriture manuscrite peut demander plus de corrections."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra un libro di cucina con la fotocamera oppure scegli delle schermate. Il riconoscimento del testo avviene su questo dispositivo. Le ricette stampate funzionano meglio; la scrittura a mano può richiedere più correzioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richt de camera op een kookboek of kies schermafbeeldingen. Tekstherkenning gebeurt op dit apparaat. Gedrukte recepten werken het best; handschrift vraagt vaak meer correcties."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponta a câmara a um livro de cozinha ou escolhe capturas de ecrã. O reconhecimento de texto é feito neste dispositivo. As receitas impressas funcionam melhor; a letra manuscrita pode precisar de mais correções."
          }
        }
      }
    },
