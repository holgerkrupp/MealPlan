          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Teilen kannst du das neue Gericht gleich auf einen Tag im Plan legen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al compartir puedes poner el plato nuevo directamente en un día de tu plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors du partage, vous pouvez placer le nouveau plat directement sur un jour de votre menu."
