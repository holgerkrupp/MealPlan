          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviter nogen til at planlægge sammen med dig"
          }
        }
      }
    },
    "Invite your family from the Household section — everyone sees the same plan and dishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade deine Familie im Bereich „Haushalt“ ein – alle sehen denselben Plan und dieselben Gerichte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a tu familia desde la sección Hogar: todos ven el mismo plan y los mismos platos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitez votre famille depuis la section Foyer — tout le monde voit le même menu et les mêmes plats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita la tua famiglia dalla sezione Famiglia: tutti vedono lo stesso piano e gli stessi piatti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodig je gezin uit via het onderdeel Huishouden — iedereen ziet hetzelfde plan en dezelfde gerechten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convida a tua família na secção Casa — todos veem o mesmo plano e os mesmos pratos."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviter din familie fra afsnittet Husstand — alle ser den samme plan og de samme retter."
          }
        }
      }
    },
