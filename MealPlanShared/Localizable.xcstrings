    "Pick the Bring! list this family’s shopping list belongs to. Everyone in your family who connects their own Bring! account should pick the same one." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg den Bring!-liste, som denne families indkøbsliste hører til. Alle i familien, der forbinder deres egen Bring!-konto, bør vælge den samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Bring!-Liste, zu der die Einkaufsliste dieser Familie gehört. Alle in der Familie, die ihr eigenes Bring!-Konto verbinden, sollten dieselbe wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la lista de Bring! a la que pertenece la lista de la compra de esta familia. Todas las personas de tu familia que conecten su propia cuenta de Bring! deberían elegir la misma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la liste Bring! à laquelle appartient la liste de courses de cette famille. Toutes les personnes de votre famille qui connectent leur propre compte Bring! doivent choisir la même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la lista Bring! a cui appartiene la lista della spesa di questa famiglia. Tutti in famiglia che collegano il proprio account Bring! dovrebbero scegliere la stessa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de Bring!-lijst waar de boodschappenlijst van dit gezin bij hoort. Iedereen in je gezin die zijn eigen Bring!-account koppelt, moet dezelfde kiezen."
          }
