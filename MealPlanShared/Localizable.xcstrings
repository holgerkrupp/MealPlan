        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le propriétaire du foyer peut inviter des personnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo il proprietario può invitare altre persone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de eigenaar van het huishouden kan mensen uitnodigen."
          }
