    "Replaces everything currently on this device with the contents of the backup. You’ll see what’s in the file before anything is changed." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstatter alt, hvad der nu ligger på denne enhed, med indholdet af sikkerhedskopien. Du får at se, hvad filen indeholder, før noget ændres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplaza todo lo que hay ahora en este dispositivo por el contenido de la copia de seguridad. Verás lo que contiene el archivo antes de que se cambie nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace tout ce qui se trouve actuellement sur cet appareil par le contenu de la sauvegarde. Vous verrez ce que contient le fichier avant toute modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce tutto ciò che è ora su questo dispositivo con il contenuto del backup. Vedrai cosa contiene il file prima che venga cambiato qualcosa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervangt alles wat nu op dit apparaat staat door de inhoud van de back-up. Je ziet wat er in het bestand zit voordat er iets verandert."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui tudo o que está agora neste dispositivo pelo conteúdo da cópia de segurança. Vais ver o que está no ficheiro antes de algo ser alterado."
          }
        }
      }
    },
