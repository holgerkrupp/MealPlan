    "Plan the week meal by meal on a calendar the whole family sees." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlæg ugen måltid for måltid i en kalender, som hele familien kan se."
