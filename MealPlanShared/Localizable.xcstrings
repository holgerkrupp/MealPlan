    "Cooking mode walks you through the steps and scales ingredients to the servings you cook." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilberedningstilstand guider dig gennem trinnene og skalerer ingredienserne til de portioner, du laver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kochmodus führt dich durch die Schritte und rechnet die Zutaten auf die Portionen um, die du kochst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de cocina te guía por los pasos y ajusta los ingredientes a las raciones que preparas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode cuisine vous guide pas à pas et adapte les ingrédients au nombre de portions que vous préparez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità cucina ti guida passo dopo passo e adatta gli ingredienti alle porzioni che prepari."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kookmodus leidt je door de stappen en past de ingrediënten aan het aantal porties aan dat je maakt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de cozinha guia-te pelos passos e ajusta os ingredientes às doses que preparas."
          }
        }
      }
    },
