        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi i pasti che piacciono alla tua famiglia. Un nome basta per iniziare: ricetta e foto possono arrivare dopo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg de maaltijden toe die je gezin lekker vindt. Een naam is genoeg om te beginnen — een recept en foto kun je later toevoegen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona as refeições de que a tua família gosta. Um nome basta para começar — podes acrescentar a receita e a foto depois."
