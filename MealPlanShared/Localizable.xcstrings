    "The shopping list is built from the days you plan to cook, so it matches what is actually on the calendar." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indkøbslisten bygges ud fra de dage, du planlægger at lave mad, så den passer til det, der faktisk står i kalenderen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einkaufsliste entsteht aus den Tagen, an denen du kochen willst – sie passt also zu dem, was wirklich im Kalender steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista de la compra se construye a partir de los días en los que planeas cocinar, así que coincide con lo que hay realmente en el calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste de courses est construite à partir des jours où vous prévoyez de cuisiner : elle correspond donc à ce qui figure réellement au calendrier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista della spesa nasce dai giorni in cui hai in programma di cucinare, quindi corrisponde a ciò che c’è davvero nel calendario."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De boodschappenlijst wordt opgebouwd uit de dagen waarop je wilt koken, dus hij past bij wat er echt op de kalender staat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista de compras é criada a partir dos dias em que planeias cozinhar, por isso corresponde ao que está realmente no calendário."
          }
        }
      }
    },
