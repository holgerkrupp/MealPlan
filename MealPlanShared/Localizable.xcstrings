    "Every line goes, ticked or not, here and — at the next sync — in Bring! too. Rebuild from the plan to get the planned ones back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile verschwindet, abgehakt oder nicht – hier und beim nächsten Synchronisieren auch in Bring!. Mit „Aus Plan neu aufbauen“ kommen die geplanten zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las líneas desaparecen, marcadas o no, aquí y —en la próxima sincronización— también en Bring!. Vuelve a crear la lista desde el plan para recuperar las planificadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les lignes disparaissent, cochées ou non, ici et — à la prochaine synchronisation — dans Bring! aussi. Reconstruisez la liste depuis le menu pour récupérer les articles prévus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le righe spariscono, spuntate o no, qui e — alla prossima sincronizzazione — anche in Bring!. Ricrea la lista dal piano per riavere quelle pianificate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle regels verdwijnen, afgevinkt of niet, hier en — bij de volgende synchronisatie — ook in Bring!. Bouw de lijst opnieuw op vanuit het plan om de geplande items terug te krijgen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as linhas desaparecem, assinaladas ou não, aqui e — na próxima sincronização — também no Bring!. Reconstrói a lista a partir do plano para recuperar as planeadas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle linjer forsvinder, afkrydsede eller ej, her og — ved næste synkronisering — også i Bring!. Byg listen op igen ud fra planen for at få de planlagte tilbage."
          }
        }
      }
    },
