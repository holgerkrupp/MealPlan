    "Everyone who accepts sees the same dishes and plan." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las personas que acepten verán los mismos platos y el mismo plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les personnes qui acceptent voient les mêmes plats et le même menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti quelli che accettano vedono gli stessi piatti e lo stesso piano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen die accepteert ziet dezelfde gerechten en hetzelfde plan."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as pessoas que aceitarem veem os mesmos pratos e o mesmo plano."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, der accepterer, ser de samme retter og den samme plan."
          }
        }
      }
    },
    "Everyone you invite sees the same plan and dishes. You can invite people as editors or view-only guests." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las personas a las que invites verán el mismo plan y los mismos platos. Puedes invitarlas como editores o como invitados de solo lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les personnes que vous invitez voient le même menu et les mêmes plats. Vous pouvez les inviter comme éditeurs ou en lecture seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le persone che inviti vedono lo stesso piano e gli stessi piatti. Puoi invitarle come editor o come ospiti in sola lettura."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen die je uitnodigt ziet hetzelfde plan en dezelfde gerechten. Je kunt mensen uitnodigen als bewerker of als alleen-lezen gast."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as pessoas que convidares veem o mesmo plano e os mesmos pratos. Podes convidá-las como editores ou como convidados só de leitura."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, du inviterer, ser den samme plan og de samme retter. Du kan invitere folk som redaktører eller som gæster med kun læseadgang."
          }
        }
      }
    },
    "Everything in that file is already in your library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
