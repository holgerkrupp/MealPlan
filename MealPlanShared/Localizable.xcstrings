    "A name is enough to add a dish — recipe, photo, and ingredients can follow later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Name reicht für ein neues Gericht – Rezept, Foto und Zutaten kannst du später ergänzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un nombre basta para añadir un plato: la receta, la foto y los ingredientes pueden venir después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nom suffit pour ajouter un plat — la recette, la photo et les ingrédients peuvent venir plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nome basta per aggiungere un piatto: ricetta, foto e ingredienti possono arrivare dopo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een naam is genoeg om een gerecht toe te voegen — recept, foto en ingrediënten kunnen later volgen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um nome basta para adicionar um prato — a receita, a foto e os ingredientes podem vir depois."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et navn er nok til at tilføje en ret — opskrift, billede og ingredienser kan komme senere."
          }
        }
      }
    },
