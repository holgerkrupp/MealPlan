    "Your shopping list can be sent to Bring! — or kept in step with it, so ticking something off in either app ticks it off in the other." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din indkøbsliste kan sendes til Bring! — eller holdes synkroniseret med den, så en afkrydsning i den ene app også krydser af i den anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Einkaufsliste kann an Bring! gesendet oder mit Bring! synchron gehalten werden – abgehakt in der einen App heißt dann abgehakt in der anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu lista de la compra se puede enviar a Bring! —o mantenerse sincronizada con ella—, de modo que marcar algo en una app lo marque en la otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre liste de courses peut être envoyée vers Bring! — ou synchronisée avec elle, pour que cocher un article dans l’une le coche dans l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua lista della spesa può essere inviata a Bring! oppure mantenuta sincronizzata, così spuntare qualcosa in un’app lo spunta anche nell’altra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je boodschappenlijst kan naar Bring! worden gestuurd — of ermee gelijk worden gehouden, zodat iets afvinken in de ene app het ook in de andere afvinkt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tua lista de compras pode ser enviada para o Bring! — ou mantida sincronizada com ele, para que assinalar algo numa das apps o assinale na outra."
          }
        }
      }
    },
