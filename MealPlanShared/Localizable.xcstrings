    "Add the meals your family likes. A name is enough to start — you can add a recipe and a photo later." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj de måltider, din familie kan lide. Et navn er nok til at starte — opskrift og billede kan komme senere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade las comidas que le gustan a tu familia. Con un nombre basta para empezar: la receta y la foto pueden venir después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les repas que votre famille aime. Un nom suffit pour commencer — vous pourrez ajouter une recette et une photo plus tard."
          }
