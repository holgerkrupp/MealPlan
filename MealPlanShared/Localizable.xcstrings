    "While sharing you can put the new dish straight onto a day in your plan." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du deler, kan du lægge den nye ret direkte på en dag i din plan."
          }
        },
