    "Text recognition runs on this device. Printed recipes work best; handwriting may need more corrections." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstgenkendelsen kører på denne enhed. Trykte opskrifter virker bedst; håndskrift kan kræve flere rettelser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de texto se ejecuta en este dispositivo. Las recetas impresas funcionan mejor; la escritura a mano puede necesitar más correcciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance de texte s’effectue sur cet appareil. Les recettes imprimées fonctionnent le mieux ; l’écriture manuscrite peut demander plus de corrections."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento del testo avviene su questo dispositivo. Le ricette stampate funzionano meglio; la scrittura a mano può richiedere più correzioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstherkenning gebeurt op dit apparaat. Gedrukte recepten werken het best; handschrift vraagt vaak meer correcties."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reconhecimento de texto é feito neste dispositivo. As receitas impressas funcionam melhor; a letra manuscrita pode precisar de mais correções."
          }
        }
      }
    },
