    },
    "The bottom row plans it as an extra on that day, without using one of your meals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die unterste Reihe plant es als Extra an diesem Tag ein – ohne eine deiner Mahlzeiten zu belegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
