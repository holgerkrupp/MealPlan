    },
    "The plan shows one card per meal per day. Fill the cards you care about and leave the rest empty." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen viser ét kort pr. måltid pr. dag. Udfyld de kort, du går op i, og lad resten stå tomme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Plan zeigt pro Tag eine Karte je Mahlzeit. Füll die Karten, die dich interessieren, und lass den Rest leer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan muestra una tarjeta por comida y día. Rellena las tarjetas que te importen y deja el resto vacías."
