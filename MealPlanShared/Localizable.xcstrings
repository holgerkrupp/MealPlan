    "Both recipes stay separate — they're only shown together, so you can pick the one you feel like cooking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Rezepte bleiben eigenständig – sie werden nur zusammen angezeigt, damit du dir aussuchen kannst, worauf du Lust hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas recetas siguen siendo independientes: solo se muestran juntas para que elijas la que te apetezca cocinar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux recettes restent distinctes — elles sont simplement affichées ensemble pour que vous choisissiez celle qui vous tente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le due ricette restano separate: vengono solo mostrate insieme, così puoi scegliere quella che ti va di cucinare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide recepten blijven op zichzelf staan — ze worden alleen samen getoond, zodat je kunt kiezen waar je zin in hebt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As duas receitas mantêm-se separadas — só são mostradas juntas para poderes escolher a que te apetece cozinhar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begge opskrifter forbliver selvstændige — de vises bare sammen, så du kan vælge den, du har lyst til at lave."
          }
        }
      }
    },
