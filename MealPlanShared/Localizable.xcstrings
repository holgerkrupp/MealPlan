    "Back up everything to a file, or restore one — the way to carry your library into a build that syncs with a different iCloud database." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopiér alt til en fil, eller gendan en — sådan flytter du din samling over i en build, der synkroniserer med en anden iCloud-database."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una copia de todo en un archivo, o restaura una: así llevas tu colección a una versión que se sincroniza con otra base de datos de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardez tout dans un fichier ou restaurez une sauvegarde — c’est le moyen de transférer votre collection vers une version qui se synchronise avec une autre base de données iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva tutto in un file oppure ripristina un backup: è il modo per portare la tua raccolta in una build che si sincronizza con un altro database iCloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een back-up van alles in een bestand of zet er een terug — zo neem je je collectie mee naar een build die met een andere iCloud-database synchroniseert."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tudo num ficheiro ou restaura uma cópia — é assim que levas a tua coleção para uma build que sincroniza com outra base de dados iCloud."
          }
        }
      }
    },
